SPRING_PROFILES_ACTIVE=dev

CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3000,http://localhost:8081

DB_HOST=localhost
DB_PORT=5432
DB_NAME=obd
DB_USER=obd_user
DB_PASSWORD=obd_password

REDIS_HOST=localhost
REDIS_PORT=6379

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=rustfsadmin
OBJECT_STORAGE_SECRET_KEY=rustfsadmin123

# Required. HMAC-SHA256 signing secret for access tokens.
# Generate locally with: openssl rand -base64 48
JWT_SECRET=

# Optional. Refresh-token lifetime in seconds (default 604800 = 7 days).
REFRESH_TOKEN_TTL_SECONDS=604800
