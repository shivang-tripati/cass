POSTGRES_DB=obd
POSTGRES_USER=obd_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_PORT=6379

RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Phase B live FreeSWITCH  (infra/docker-compose.freeswitch.yml)
# ---------------------------------------------------------------------------
# Generate a real value, e.g. a 32-byte base64url string, and put it in the
# git-ignored infra/.env. Never commit an actual secret.
#
# The FreeSWITCH image ships the well-known ESL password "ClueCon" and the
# platform's dev default is "fs-password"; the container entrypoint refuses
# both, and refuses anything shorter than 16 characters, so a placeholder
# left here fails loudly at startup instead of silently weakening ESL.
FREESWITCH_PASSWORD=replace-with-strong-local-secret

# The four values below are NOT read by Docker Compose. They are the
# application-side telephony.freeswitch.* settings, to be supplied to the
# Spring Boot process in a later phase (telephony.freeswitch.enabled is
# currently false). They are listed here so the whole FreeSWITCH contract
# has one documented place.
#
# FREESWITCH_HOST is localhost because the ESL port is published to
# 127.0.0.1:8021. A containerised application would use freeswitch:8021
# (the Docker Compose service alias on the obd-telephony network) instead.
#
# FREESWITCH_GATEWAY must match the sofia gateway name in
# infra/freeswitch/gateway/fs-gateway.xml, and must also match the
# sip_gateways.free_switch_gateway_name value used by the database seed,
# because campaign outbound and the agent leg resolve the gateway from two
# different places.
FREESWITCH_HOST=localhost
FREESWITCH_PORT=8021
FREESWITCH_GATEWAY=fs-gateway
FREESWITCH_PROFILE=external

# ---------------------------------------------------------------------------
# Phase C local SIP test endpoints
# (infra/docker-compose.freeswitch-endpoints.yml)
# ---------------------------------------------------------------------------
# Two local SIP endpoints run as additional FreeSWITCH containers on the
# obd-telephony network, registering as extensions 1001 and 1002.
#
# They must be in-network: the Windows host has no route to the Docker bridge
# network, so a host softphone can register and originate but can never be
# called back and can never carry RTP. See docs/freeswitch/decisions/ADR-004.
#
# The per-extension SIP passwords below are ONLY used by these test endpoints.
# They are the credentials the endpoints present when registering, and they
# must match what the platform switch's directory holds. The platform's
# directory is infra/freeswitch/conf/directory/default.xml.in, which is a
# TEMPLATE: the entrypoint substitutes these values at container start, so no
# credential is committed.
#
# The stock FreeSWITCH directory defines users 1000-1014 whose password is a
# publicly known value in vars.xml. Phase C REPLACES that directory entirely,
# because enabling SIP registration against it would accept a known
# credential - and because the stock set collides with extension 1001, which
# makes a CORRECT password answer 403. The entrypoint refuses to start if any
# user id other than 1001/1002 is present. See ADR-005.
#
# Same rules as FREESWITCH_PASSWORD: real local values in the git-ignored
# infra/.env, and the entrypoints refuse weak or placeholder values loudly.
SIP_1001_PASSWORD=replace-with-strong-local-secret
SIP_1002_PASSWORD=replace-with-strong-local-secret

# ESL for the two test endpoints. Separate from FREESWITCH_PASSWORD because
# these are different containers with different exposure: the endpoint ports
# are published on loopback so the harness can read the endpoints' own media
# counters. Not needed unless you run the endpoints.
ENDPOINT_ESL_PASSWORD=replace-with-strong-local-secret

# Optional, with defaults. The DTMF sequence each endpoint emits toward the
# platform switch, so the platform can be shown a known, reproducible input.
# Covers the digits Phase C needs plus * and #.
ENDPOINT_DTMF_DIGITS=0159#*

# How long an endpoint stays answered after picking up, in milliseconds.
# Long enough for a harness to inspect the call.
ENDPOINT_ANSWER_HOLD_MS=30000
